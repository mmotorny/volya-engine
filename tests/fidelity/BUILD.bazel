load("//build:checks.bzl", "volya_checks")

# The fidelity suite's views and the audio-fidelity suite's walks, the
# engine's self-test's and the Windows capture's plan's (`include!`).
exports_files(
    [
        "views.rs",
        "walks.rs",
    ],
    visibility = ["//visibility:public"],
)

# The original's frames of the views (game assets, in the local cache only,
# build/original_frames.bzl), what the fidelity suite is served:
# `fidelity/<view>.png`.
alias(
    name = "frames",
    actual = "@original_frames//:frames",
    visibility = ["//tests/browser:__pkg__"],
)

# The original's audio of the walks (game assets, in the local cache only,
# build/original_frames.bzl), what the audio-fidelity suite is served:
# `audio-fidelity/<walk>.wav` and `<walk>.frames.txt`.
alias(
    name = "audio",
    actual = "@original_audio//:files",
    visibility = ["//tests/browser:__pkg__"],
)

volya_checks(wasm = False)
