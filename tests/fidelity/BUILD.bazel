load("//build:checks.bzl", "volya_checks")
load("//build:original.bzl", "original_frames")

# The fidelity suite's views, shared by the engine's self-test and xtask's
# capture of the original (`include!`).
exports_files(
    ["views.rs"],
    visibility = ["//visibility:public"],
)

# The original's frames of the views (game assets, in the local disk cache
# only), what the fidelity suite is served: `fidelity/<view>.png`. One run
# of the original, minutes; built when the fidelity suite runs, or by name.
original_frames(
    name = "frames",
    tags = ["manual"],
    visibility = ["//tests/browser:__pkg__"],
)

volya_checks(wasm = False)
