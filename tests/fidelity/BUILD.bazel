load("//build:checks.bzl", "volya_checks")

# The fidelity suite's views, the engine's self-test's (`include!`).
exports_files(
    ["views.rs"],
    visibility = ["//visibility:public"],
)

# The original's frames of the views (game assets, in the local cache only,
# build/original_frames.bzl), what the fidelity suite is served:
# `fidelity/<view>.png`.
alias(
    name = "frames",
    actual = "@original_frames//:frames",
    visibility = ["//tests/browser:__pkg__"],
)

volya_checks(wasm = False)
