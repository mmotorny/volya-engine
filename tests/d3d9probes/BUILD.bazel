load("//build:checks.bzl", "volya_checks")
load("//build:d3d9probes.bzl", "d3d9probes_exe", "d3d9probes_references", "d3d9probes_wine", "d3d9probes_zip")

package(default_visibility = ["//visibility:public"])

# d3d9probes.exe, built with MinGW in the Wine image: a container, so built
# by name or by what needs it, not by //....
d3d9probes_exe(
    name = "exe",
    srcs = glob([
        "*.c",
        "*.h",
    ]),
    out = "d3d9probes.exe",
    tags = ["manual"],
)

# The probes under Wine: `wine/results/` and `wine/log.txt`, in the disk
# cache, run again only when the executable or the image changes.
d3d9probes_wine(
    name = "wine",
    exe = ":exe",
    tags = ["manual"],
)

# What the `d3d9probes` browser suite compares our replay with: Wine's
# results and each GPU's committed under hardware/ (docs/testing.md).
d3d9probes_references(
    name = "references",
    hardware = glob(
        ["hardware/*/results/**"],
        allow_empty = True,
    ),
    tags = ["manual"],
    wine = ":wine",
)

# The Windows runner, d3d9probes.exe and README.txt (docs/testing.md;
# `bazel run //tools/xtask -- d3d9probes release` publishes it).
d3d9probes_zip(
    name = "runner",
    srcs = [
        "README.txt",
        ":exe",
    ],
    out = "d3d9probes.zip",
    tags = ["manual"],
)

volya_checks(wasm = False)
