load("//build:checks.bzl", "volya_checks")
load("//build:d3d9probes.bzl", "d3d9probes_exe", "d3d9probes_references", "d3d9probes_zip")

package(default_visibility = ["//visibility:public"])

# d3d9probes.exe, built with llvm-mingw.
d3d9probes_exe(
    name = "exe",
    srcs = glob([
        "*.c",
        "*.h",
    ]),
    out = "d3d9probes.exe",
)

# What the `d3d9probes` browser suite compares our replay with: each GPU's
# results committed under hardware/ (docs/testing.md).
d3d9probes_references(
    name = "references",
    hardware = glob(
        ["hardware/*/results/**"],
        allow_empty = True,
    ),
)

# The Windows runner, d3d9probes.exe and README.txt (docs/testing.md;
# `bazel run //tools/xtask -- d3d9probes release` publishes it).
d3d9probes_zip(
    name = "runner",
    srcs = [
        "README.txt",
        ":exe",
    ],
    out = "d3d9probes.zip",
)

volya_checks(wasm = False)
