load("//build:checks.bzl", "volya_checks")
load("//build:rust.bzl", "LINTS")
load("//build:web.bzl", "next_site", "web_site")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# The engine for the browser (empty natively; the sites below build it for
# wasm32).
rust_shared_library(
    name = "volya-engine-web",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = select({
        "//build:with_test_ops": ["test-ops"],
        "//conditions:default": [],
    }),
    crate_name = "volya_engine_web",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_flags = LINTS,
    deps = all_crate_deps(normal = True) + [
        "//crates/volya-engine",
        "//crates/volya-engine-formats",
        "//crates/volya-engine-installer",
    ],
)

STATIC = glob(["static/**"])

# Deployed.
web_site(
    name = "site",
    compilation_mode = "opt",
    static = STATIC,
    wasm = ":volya-engine-web",
)

# What browser suites run: optimised, with the test ops.
web_site(
    name = "site_test",
    compilation_mode = "opt",
    static = STATIC,
    test_ops = True,
    wasm = ":volya-engine-web",
)

# Unoptimised, with the test ops (the dev server).
web_site(
    name = "site_dev",
    compilation_mode = "fastbuild",
    static = STATIC,
    test_ops = True,
    wasm = ":volya-engine-web",
)

# The update flow's next build (tests/browser/smoke.js).
next_site(
    name = "site_next",
    site = ":site_test",
    static = STATIC,
)

volya_checks()
