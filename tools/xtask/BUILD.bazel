load("@gog_installer//:defs.bzl", "GOG_INSTALLER")
load("//build:checks.bzl", "volya_checks")
load("//build:rust.bzl", "LINTS", "volya_binary")
load("@rules_rust//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

volya_binary(
    name = "xtask",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    env = {
        "VOLYA_GOG_INSTALLER": GOG_INSTALLER,
    },
    deps = [
        "//tools/devserver:volya-engine-devserver",
        "//tools/site:volya-engine-site",
    ],
)

# The Direct3D 9 probes' actions' tool (build/d3d9probes.bzl): their
# modules alone, so an edit elsewhere in xtask builds nothing again.
volya_binary(
    name = "d3d9probes-action",
    srcs = [
        "src/common.rs",
        "src/d3d9probes.rs",
        "src/d3d9probes_action.rs",
    ],
    crate_root = "src/d3d9probes_action.rs",
)

rust_test(
    name = "xtask-unit",
    crate = ":xtask",
    rustc_flags = LINTS,
)

volya_checks(wasm = False)
