load("@gog_installer//:defs.bzl", "GOG_INSTALLER")
load("//build:checks.bzl", "volya_checks")
load("//build:rust.bzl", "LINTS", "volya_binary")
load("@rules_rust//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

volya_binary(
    name = "xtask",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    # The fidelity suite's views (src/original/views.rs).
    compile_data = ["//tests/fidelity:views.rs"],
    # `bazel run //tools/xtask -- original`: the install folder.
    data = ["@gog_original//:manifest.tsv"],
    env = {
        "VOLYA_GOG_INSTALLER": GOG_INSTALLER,
        "VOLYA_GOG_ORIGINAL": "$(rootpath @gog_original//:manifest.tsv)",
    },
    deps = [
        "//tools/devserver:volya-engine-devserver",
        "//tools/site:volya-engine-site",
    ],
)

# The capture actions' tool (build/original.bzl): the `original` modules
# alone, so an edit elsewhere in xtask captures nothing again.
volya_binary(
    name = "capture",
    srcs = [
        "src/capture.rs",
        "src/common.rs",
        "src/machine.rs",
        "src/original.rs",
        "src/original/views.rs",
        "src/wine.rs",
    ],
    compile_data = ["//tests/fidelity:views.rs"],
    crate_root = "src/capture.rs",
)

# The Wine image's file: the capture actions' input (its hash tags the
# image, wine.rs).
exports_files(["wine/Containerfile"])

rust_test(
    name = "xtask-unit",
    crate = ":xtask",
    rustc_flags = LINTS,
)

volya_checks(wasm = False)
