# `cargo xtask wine`: headless 32-bit Wine on arm64. The i386 Linux side of
# Wine runs through QEMU user mode, registered with binfmt_misc at run time.

# qemu-i386 built from a QEMU release with upstream commit 586284af4c2c
# ("linux-user/i386: report the real trap number in sigcontext.trapno", in
# QEMU 11.2): before it, every CPU fault reaches Wine with trap number -1,
# which Wine's i386 fault handler turns into an illegal instruction instead
# of servicing it (measured: Wine's services logged "Got unexpected trap -1"
# and their threads died).
FROM debian:trixie-slim AS qemu
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils patch build-essential python3 python3-venv \
      ninja-build pkg-config libglib2.0-dev
ARG QEMU=11.1.3
ARG FIX=586284af4c2cfa90fd61cff414b0deb77acd70f7
RUN curl -fsSL https://download.qemu.org/qemu-$QEMU.tar.xz | tar -xJ \
    && cd qemu-$QEMU \
    && curl -fsSL https://github.com/qemu/qemu/commit/$FIX.patch | patch -p1 \
    && ./configure --target-list=i386-linux-user --static --disable-system \
      --disable-tools --disable-docs \
    && ninja -C build qemu-i386 \
    && cp build/qemu-i386 /qemu-i386

FROM debian:trixie-slim
RUN dpkg --add-architecture i386 && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      qemu-user qemu-user-binfmt wine wine32:i386 xvfb xauth \
      libgl1:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386 \
      gcc-mingw-w64-i686 mingw-w64-i686-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=qemu /qemu-i386 /usr/bin/qemu-i386
ENV WINEPREFIX=/root/wine WINEARCH=win32 WINEDLLOVERRIDES=mscoree,mshtml= WINEDEBUG=fixme-all
