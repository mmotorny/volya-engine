# `cargo xtask wine`: headless 32-bit Wine on arm64. The i386 Linux side of
# Wine runs through QEMU user mode, registered with binfmt_misc at run time.
FROM debian:trixie-slim
RUN dpkg --add-architecture i386 && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      qemu-user qemu-user-binfmt wine wine32:i386 xvfb xauth \
      libgl1:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386 \
      gcc-mingw-w64-i686 mingw-w64-i686-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV WINEPREFIX=/root/wine WINEARCH=win32 WINEDLLOVERRIDES=mscoree,mshtml= WINEDEBUG=fixme-all
