# `xtask wine`: headless 32-bit Wine on arm64 through
# box64. Wine is an x86_64 build in WoW64 mode (its 32-bit side is PE code in
# a 64-bit process), so box64 runs it all; box64 wraps the arm64 X11, Mesa
# and font libraries installed here. Wine's x86_64 ELF parts start through
# binfmt_misc, registered at run time. Both carry the frame clock
# (docs/testing.md): Wine from a fork (LGPL, so its patch stays out of this
# repository), box64 from the build context, its release with our patch
# applied by Bazel (`@box64`, third_party/box64/).

# box64 (Debian has 0.3.4).
FROM debian:trixie-slim AS box64
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential cmake python3
COPY . /box64-src
RUN cmake -S /box64-src -B build -DARM_DYNAREC=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    && cmake --build build -j"$(nproc)" \
    && cp build/box64 /box64
# The x86_64 libraries box64 runs emulated rather than wraps (Wine needs its
# libgcc_s), where its install puts them.
RUN cp -R /box64-src/x64lib /x64lib

# Wine 11.0 with the frame clock (https://github.com/mmotorny/wine, branch
# volya-frame-clock), built as x86_64 (under Rosetta in Apple's builder) in
# WoW64 mode: the stable release, as development release 11.22 aborts under
# box64 at start (measured: an assertion on its mapping granularity in
# Wine's virtual memory code, with box64 0.3.4 and 0.4.4).
FROM --platform=linux/amd64 debian:trixie-slim AS wine
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl build-essential flex bison \
      gcc-mingw-w64-i686 gcc-mingw-w64-x86-64 \
      libx11-dev libxext-dev libxrender-dev libxrandr-dev libxi-dev libxcursor-dev \
      libxcomposite-dev libxinerama-dev libxfixes-dev libxxf86vm-dev libxkbcommon-dev \
      libfreetype-dev libfontconfig-dev libgl-dev libegl-dev libvulkan-dev
ARG WINE=e0ac004b09da8e6943eff2f7df1b2c3e85add7f9
RUN curl -fsSL https://github.com/mmotorny/wine/archive/$WINE.tar.gz | tar -xz \
    && cd wine-$WINE \
    && ./configure --prefix=/opt/wine --enable-archs=i386,x86_64 --disable-tests \
      CFLAGS=-O2 CROSSCFLAGS=-O2 \
      --without-gstreamer --without-pulse --without-alsa --without-oss --without-cups \
      --without-sane --without-gphoto --without-v4l2 --without-pcap --without-netapi \
      --without-krb5 --without-gssapi --without-capi --without-usb --without-udev \
      --without-dbus --without-wayland --without-ffmpeg --without-sdl --without-unwind \
    && make -j"$(nproc)" \
    && make install \
    && cd .. && rm -rf wine-$WINE

FROM debian:trixie-slim
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      xvfb xauth xdotool \
      libgl1 libgl1-mesa-dri libglx-mesa0 libegl1 libvulkan1 \
      libx11-6 libxext6 libxrender1 libxrandr2 libxi6 libxcursor1 libxcomposite1 \
      libxinerama1 libxfixes3 libxxf86vm1 libxkbcommon0 libfreetype6 libfontconfig1 \
      gcc-mingw-w64-i686 mingw-w64-i686-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=wine /opt/wine /opt/wine
COPY --from=box64 /box64 /usr/bin/box64
COPY --from=box64 /x64lib /usr/lib/box64-x86_64-linux-gnu
ENV PATH=/opt/wine/bin:$PATH WINEPREFIX=/root/wine WINEDLLOVERRIDES=mscoree,mshtml= WINEDEBUG=fixme-all
