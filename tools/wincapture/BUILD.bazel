load("//build:checks.bzl", "volya_checks")
load("//build:d3d9probes.bzl", "d3d9probes_zip")
load("//build:wincapture.bzl", "wincapture_binary", "wincapture_plan")
load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# The frame clock: a proxy winmm.dll for the game's bin\ (frameclock.c).
wincapture_binary(
    name = "winmm",
    srcs = [
        "detheap.c",
        "detheap.h",
        "frameclock.c",
        "frameclock.h",
        "redact.h",
        "winmm_exports.h",
    ],
    kind = "dll",
    out = "winmm.dll",
)

# The time-stamp counter on the frame clock: a DynamoRIO client
# (counter.c).
wincapture_binary(
    name = "counter",
    srcs = [
        "counter.c",
        "frameclock.h",
    ],
    kind = "client",
    out = "counter.dll",
    sdk = ["@dynamorio//:client_sdk"],
)

# The bisect's variant of the client (`volyacapture --kernel32-client`):
# the shared memory opened through kernel32, as before
# docs/behavior/capture-recipe.md's rule 2. Diagnostic only.
wincapture_binary(
    name = "counter-kernel32",
    srcs = [
        "counter.c",
        "frameclock.h",
    ],
    kind = "client-kernel32",
    out = "counter-kernel32.dll",
    sdk = ["@dynamorio//:client_sdk"],
)

# The driver (capture.c) and its audio recording (loopback.c).
wincapture_binary(
    name = "volyacapture",
    srcs = [
        "capture.c",
        "detheap.h",
        "frameclock.h",
        "loopback.c",
        "loopback.h",
        "redact.h",
    ],
    kind = "exe",
    out = "volyacapture.exe",
)

# The self-test's program (counterprobe.c).
wincapture_binary(
    name = "counterprobe",
    srcs = [
        "counterprobe.c",
        "frameclock.h",
    ],
    kind = "exe",
    out = "counterprobe.exe",
)

# The deterministic heap (detheap.c), natively on this machine: its size
# classes, LIFO reuse, reallocation and placeholder handles.
cc_test(
    name = "detheap_test",
    size = "small",
    srcs = [
        "detheap.c",
        "detheap.h",
        "detheap_test.c",
    ],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
)

# The views, their frames and settings (tests/fidelity/views.rs).
wincapture_plan(
    name = "plan",
    out = "plan.txt",
)

# The Windows runner (docs/testing.md, The original on Windows;
# `bazel run //tools/xtask -- wincapture release` publishes it), with
# DynamoRIO's 32-bit drrun and runtime in dynamorio\, laid out as in its
# release.
d3d9probes_zip(
    name = "runner",
    srcs = [
        "README.txt",
        ":counter",
        ":counter-kernel32",
        ":counterprobe",
        ":plan",
        ":volyacapture",
        ":winmm",
    ],
    out = "wincapture.zip",
    trees = {"@dynamorio//:runtime": "dynamorio"},
)

volya_checks(wasm = False)
