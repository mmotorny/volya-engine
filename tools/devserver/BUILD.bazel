load("//build:checks.bzl", "volya_checks")
load("//build:rust.bzl", "volya_binary", "volya_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

volya_library(name = "volya-engine-devserver")

volya_binary(
    name = "devserver",
    srcs = ["src/main.rs"],
    # `bazel run //tools/devserver` serves the dev site.
    data = ["//platforms/web:site_dev"],
    env = {"VOLYA_SITE": "$(rootpath //platforms/web:site_dev)"},
    deps = [":volya-engine-devserver"],
)

volya_checks(wasm = False)
