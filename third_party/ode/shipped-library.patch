@@ -166,6 +133,27 @@ void dxStepBody (dxBody *b, dReal h)
 //****************************************************************************
 // island processing
 
+// the shipped library steps a world as one group: when the world has a body,
+// every joint of its joint list and every body of its body list, each in list
+// order, with each body's disabled flag cleared, in one call of the stepper.
+// there is no island search and no auto-disabling.
+
+void dxProcessWorld (dxWorld *world, dReal stepsize, dstepper_fn_t stepper)
+{
+  if (world->nb <= 0) return;
+  dxBody **body = (dxBody**) ALLOCA (world->nb * sizeof(dxBody*));
+  dxJoint **joint = (dxJoint**) ALLOCA (world->nj * sizeof(dxJoint*));
+  int nb = 0, nj = 0;
+  for (dxJoint *j=world->firstjoint; j; j=(dxJoint*)j->next) joint[nj++] = j;
+  for (dxBody *b=world->firstbody; b; b=(dxBody*)b->next) {
+    b->flags &= ~dxBodyDisabled;
+    body[nb++] = b;
+  }
+  stepper (world,body,nb,joint,nj,stepsize);
+}
+
+// public 0.5.0's island processing (not used by the shipped library):
+
 // this groups all joints and bodies in a world into islands. all objects
 // in an island are reachable by going through connected bodies and joints.
 // each island can be simulated separately.
