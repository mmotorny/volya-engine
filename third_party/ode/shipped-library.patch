+// the shipped library's edge-edge contacts. a box is (p,R,half sides H);
+// its axis j is column j of R. for box `own' with edge axis k, of its other
+// two axes the one with the larger |n . axis| (the second when equal) is M,
+// the other S. every dot product here is summed (y + z) + x
+// (physics-harness-3.md 2.4).
+
+static void edgeEdgeAxes (const dMatrix3 R, const dVector3 n, int k,
+			  int *M, int *S)
+{
+  int a = (k+1)%3, b = (k+2)%3;
+  dReal na = dFabs (dxDOT14 (dxSumYZX,n,R+a));
+  dReal nb = dFabs (dxDOT14 (dxSumYZX,n,R+b));
+  if (na > nb) { *M = a; *S = b; }
+  else { *M = b; *S = a; }
+}
+
+
+// a candidate: face j (sign s) of box (R,H) against the line through P
+// along unit u, the face's centre taken from the point pc (the box's centre,
+// but box 2's for box 1's faces on its own edge axis). writes the point Q
+// where the line meets the face's plane and returns 1 when Q is within the
+// face.
+
+static int edgeEdgeCandidate (const dVector3 pc, const dMatrix3 R,
+			      const dReal H[3], int j, dReal s,
+			      const dVector3 P, const dVector3 u, dVector3 Q)
+{
+  dVector3 F;
+  int i;
+  for (i=0; i<3; i++) F[i] = pc[i] + s*H[j]*R[i*4+j];
+  dReal t = (dxDOT14 (dxSumYZX,P,R+j) - dxDOT14 (dxSumYZX,F,R+j)) /
+    dxDOT14 (dxSumYZX,u,R+j);
+  for (i=0; i<3; i++) Q[i] = P[i] - t*u[i];
+  int c = (j+1)%3, e = (j+2)%3;
+  return dFabs (dxDOT14 (dxSumYZX,Q,R+c) - dxDOT14 (dxSumYZX,F,R+c)) <= H[c] &&
+    dFabs (dxDOT14 (dxSumYZX,Q,R+e) - dxDOT14 (dxSumYZX,F,R+e)) <= H[e];
+}
+
+
+static int edgeEdgeContacts (const dVector3 p1, const dMatrix3 R1,
+			     const dReal A[3], const dVector3 p2,
+			     const dMatrix3 R2, const dReal B[3],
+			     const dVector3 n, dReal depth,
+			     const dVector3 pa, const dVector3 ua,
+			     const dVector3 pb, const dVector3 ub,
+			     int k1, int k2, dContactGeom *contact, int skip)
+{
+  int M1,S1,M2,S2,i,c,num = 1;
+  edgeEdgeAxes (R1,n,k1,&M1,&S1);
+  edgeEdgeAxes (R2,n,k2,&M2,&S2);
+
+  for (c=0; c<6; c++) {
+    // candidates 0-2: faces of box 2 against box 1's edge line through pa;
+    // 3-5: faces of box 1 against box 2's edge line through pb.
+    int second = (c < 3);
+    const dReal *p = second ? p2 : p1;
+    const dReal *R = second ? R2 : R1;
+    const dReal *H = second ? B : A;
+    const dReal *P = second ? pa : pb;
+    const dReal *u = second ? ua : ub;
+    int M = second ? M2 : M1;
+    int S = second ? S2 : S1;
+    int k = second ? k2 : k1;
+    int j;
+    dReal s;
+    if (c % 3 == 0) {
+      dVector3 d;
+      for (i=0; i<3; i++) d[i] = p[i] - P[i];
+      j = S;
+      s = (dxDOT14 (dxSumYZX,d,R+S) > 0) ? REAL(1.0) : REAL(-1.0);
+    }
+    else {
+      j = k;
+      s = (c % 3 == 1) ? REAL(1.0) : REAL(-1.0);
+    }
+    // candidates 4 and 5 (box 1's faces on its edge axis) take the face
+    // centre from box 2's centre (physics-harness-3.md 2.4)
+    const dReal *pc = (c >= 4) ? p2 : p;
+
+    dContactGeom *con = CONTACT (contact,num*skip);
+    if (edgeEdgeCandidate (pc,R,H,j,s,P,u,con->pos)) {
+      dVector3 qp;
+      for (i=0; i<3; i++) qp[i] = con->pos[i] - P[i];
+      con->depth = depth - dFabs (dxDOT14 (dxSumYZX,n,R+M) *
+				  dxDOT14 (dxSumYZX,qp,R+M));
+      if (con->depth > 0) num++;
+    }
+  }
+  return num;
+}
