+// the shipped library: the whole world as one group, without auto-disabling
+// (util.cpp's dxProcessWorld), with the exact stepper when the world has 3
+// joints or fewer.
+
 void dWorldStepFast1 (dWorldID w, dReal stepsize, int maxiterations)
 {
 	dUASSERT (w, "bad world argument");
 	dUASSERT (stepsize > 0, "stepsize must be > 0");
-	processIslandsFast (w, stepsize, maxiterations);
+	if (w->nb <= 0)
+		return;
+	if (w->nj <= 3)
+	{
+		dxProcessWorld (w, stepsize, &dInternalStepIsland);
+		return;
+	}
+	dxBody **bodies = (dxBody **) ALLOCA (w->nb * sizeof (dxBody *));
+	dxJoint **joints = (dxJoint **) ALLOCA (w->nj * sizeof (dxJoint *));
+	int nb = 0, nj = 0;
+	for (dxJoint *j = w->firstjoint; j; j = (dxJoint *) j->next)
+		joints[nj++] = j;
+	for (dxBody *b = w->firstbody; b; b = (dxBody *) b->next)
+	{
+		b->flags &= ~dxBodyDisabled;
+		bodies[nb++] = b;
+	}
+	dInternalStepIslandFast (w, bodies, nb, joints, nj, stepsize, maxiterations);
 }
