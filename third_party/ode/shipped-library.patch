+    joint->qrel[0] = q[0];
+    joint->qrel[1] = -q[1];
+    joint->qrel[2] = -q[2];
+    joint->qrel[3] = -q[3];
+    joint->offset[0] = pos[0];
+    joint->offset[1] = pos[1];
+    joint->offset[2] = pos[2];
