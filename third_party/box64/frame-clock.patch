 {
-    (void)emu;
+    // The emulated program's reads (with an emulator), not box64's own.
+    if (emu && FrameClockOn())
+        return (uint64_t)readFrameClock() * 100;
 
     // Hardware counter, per architecture
 #if defined(ARM64) || defined(RV64) || defined(LA64)
