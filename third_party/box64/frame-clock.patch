 #include <time.h>
 #include <math.h>
 
+#include <fcntl.h>
+#include <pthread.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+
 #include "freq.h"
 #include "debug.h"
 
+// The frame clock of a patched Wine (its include/wine/frame_clock.h): with
+// WINE_FRAME_CLOCK naming the file of its frame count and WINE_FRAME_STEP
+// the 100 ns ticks of a frame, the emulated program's time-stamp counter
+// stands still between frames and advances by the step each frame, as the
+// software counter's nanoseconds (box64's own timing stays real).
+static volatile int64_t* frame_clock;
+static int64_t frame_step;
+
+static void openFrameClock(void)
+{
+    const char* path = getenv("WINE_FRAME_CLOCK");
+    const char* step = getenv("WINE_FRAME_STEP");
+    if (!path || !*path || !step || atoll(step) <= 0) return;
+    int fd = open(path, O_RDWR | O_CREAT, 0666);
+    if (fd == -1) return;
+    struct stat st;
+    if (!fstat(fd, &st) && st.st_size < 24 && ftruncate(fd, 24) == -1) {
+        close(fd);
+        return;
+    }
+    void* map = mmap(NULL, 24, PROT_READ, MAP_SHARED, fd, 0);
+    close(fd);
+    if (map == MAP_FAILED) return;
+    frame_step = atoll(step);
+    frame_clock = map;
+}
+
+int FrameClockOn(void)
+{
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    pthread_once(&once, openFrameClock);
+    return frame_clock != NULL;
+}
+
 #if defined(RV64)
 static size_t readBinarySizeFromFile(const char* fname)
 {
@@ -127,7 +166,9 @@ static inline uint64_t readFreq()
 
