diff --git a/src/os/freq_linux.c b/src/os/freq_linux.c
--- a/src/os/freq_linux.c
+++ b/src/os/freq_linux.c
@@ -6,9 +6,77 @@
 #include <time.h>
 #include <math.h>
 
+#include <fcntl.h>
+#include <pthread.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
 #include "freq.h"
 #include "debug.h"
 
+// The frame clock of a patched Wine (its include/wine/frame_clock.h): with
+// WINE_FRAME_CLOCK naming its file (frames, hold, held, extra ticks) and
+// WINE_FRAME_STEP the 100 ns ticks of a frame, the emulated program's
+// time-stamp counter stands still between frames and advances by the step
+// each frame, as the software counter's nanoseconds at 1 GHz (box64's own
+// timing stays real). With WINE_FRAME_SPIN, each time the main thread has
+// read it that many times since the last frame, the clock advances by 1 ms
+// (the extra ticks), as Wine does for its clocks' reads.
+#define FRAME_CLOCK_SIZE 32
+static volatile int64_t* frame_clock;
+static int64_t frame_step;
+static int64_t frame_spin;
+static int64_t frame_spin_frame = -1;
+static int64_t frame_spin_reads;
+
+static void openFrameClock(void)
+{
+    const char* path = getenv("WINE_FRAME_CLOCK");
+    const char* step = getenv("WINE_FRAME_STEP");
+    if (!path || !*path || !step || atoll(step) <= 0) return;
+    int fd = open(path, O_RDWR | O_CREAT, 0666);
+    if (fd == -1) return;
+    struct stat st;
+    if (!fstat(fd, &st) && st.st_size < FRAME_CLOCK_SIZE && ftruncate(fd, FRAME_CLOCK_SIZE) == -1) {
+        close(fd);
+        return;
+    }
+    void* map = mmap(NULL, FRAME_CLOCK_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (map == MAP_FAILED) return;
+    const char* spin = getenv("WINE_FRAME_SPIN");
+    frame_spin = spin ? atoll(spin) : 0;
+    frame_step = atoll(step);
+    frame_clock = map;
+}
+
+// The frame clock's ticks after counting a read of them.
+static int64_t readFrameClock(void)
+{
+    if (frame_spin > 0 && syscall(SYS_gettid) == getpid()) {
+        int64_t frame = __atomic_load_n(&frame_clock[0], __ATOMIC_SEQ_CST);
+        if (frame != frame_spin_frame) {
+            frame_spin_frame = frame;
+            frame_spin_reads = 0;
+        }
+        if (++frame_spin_reads >= frame_spin) {
+            frame_spin_reads = 0;
+            __atomic_add_fetch(&frame_clock[3], 10000, __ATOMIC_SEQ_CST);
+        }
+    }
+    return __atomic_load_n(&frame_clock[0], __ATOMIC_SEQ_CST) * frame_step
+        + __atomic_load_n(&frame_clock[3], __ATOMIC_SEQ_CST);
+}
+
+int FrameClockOn(void)
+{
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    pthread_once(&once, openFrameClock);
+    return frame_clock != NULL;
+}
+
 #if defined(RV64)
 static size_t readBinarySizeFromFile(const char* fname)
 {
@@ -127,7 +195,9 @@
 
