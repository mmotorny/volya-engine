 {
-    (void)emu;
+    // The emulated program's reads (with an emulator), not box64's own.
+    if (emu && FrameClockOn())
+        return (uint64_t)__atomic_load_n(&frame_clock[0], __ATOMIC_SEQ_CST) * frame_step * 100;
 
