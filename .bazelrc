# Shared by every worktree (docs/architecture/build.md, Sharing across worktrees).
common --disk_cache=~/Library/Caches/volya-engine/bazel/disk-cache
common --experimental_disk_cache_gc_max_size=50G
common --repository_cache=~/Library/Caches/volya-engine/bazel/repository-cache

# A server per worktree: idle ones exit.
startup --max_idle_secs=900
startup --host_jvm_args=-Xmx3g

# The machine's memory is shared by every agent (AGENTS.md).
build --local_resources=memory=HOST_RAM*.5

test --test_output=errors

# Measurements, as Cargo's --release (the release profile without LTO).
test:measure --compilation_mode=opt

# A personal file, never committed.
try-import %workspace%/user.bazelrc
