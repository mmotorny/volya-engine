load("@@//build:notices.bzl", "build_tool", "third_party")

# wasi-sdk's LLVM: clang, its libraries and headers, llvm-ar and llvm-ranlib;
# build tools, nothing of theirs compiled in (build/notices.bzl).
build_tool(
    name = "tools",
    srcs = glob(
        [
            "bin/clang*",
            "bin/llvm-ar",
            "bin/llvm-ranlib",
            "lib/*.dylib",
            "lib/clang/**",
        ],
        exclude = ["lib/liblldb*"],
    ),
    visibility = ["//visibility:public"],
)

# wasi-sdk's C and C++ headers (wasi-libc's and libc++'s), which ODE's
# wasm32 build compiles against (crates/volya-engine-core/build.rs); none of
# its libraries are linked. Under the LLVM exception a binary built from
# them needs no notice, and the archive ships none (wasi-libc's
# musl-derived headers: #833).
third_party(
    name = "sysroot",
    srcs = glob(["share/wasi-sysroot/include/**"]),
    component = "wasi-sdk's C and C++ headers",
    license = "Apache-2.0 WITH LLVM-exception",
    visibility = ["//visibility:public"],
)

build_tool(
    name = "clang",
    srcs = ["bin/clang"],
    visibility = ["//visibility:public"],
)
