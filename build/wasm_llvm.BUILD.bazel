# wasi-sdk's LLVM: clang, its libraries and headers, llvm-ar and llvm-ranlib.
filegroup(
    name = "tools",
    srcs = glob(
        [
            "bin/clang*",
            "bin/llvm-ar",
            "bin/llvm-ranlib",
            "lib/*.dylib",
            "lib/clang/**",
        ],
        exclude = ["lib/liblldb*"],
    ),
    visibility = ["//visibility:public"],
)

exports_files(
    ["bin/clang"],
    visibility = ["//visibility:public"],
)
