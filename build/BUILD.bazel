load("//build:checks.bzl", "CHECK", "volya_checks")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_rust//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# The release profile (`-c opt`; docs/architecture/build.md, Rust).
config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

# The test build's engine ops and render self-test (Cargo's `test-ops`
# feature), set by the web app's transition (web.bzl).
bool_flag(
    name = "test_ops",
    build_setting_default = False,
)

config_setting(
    name = "with_test_ops",
    flag_values = {":test_ops": "true"},
)

exports_files(["wasm_llvm.BUILD.bazel"])

# Every source file carries SPDX headers.
rust_test(
    name = "spdx",
    srcs = ["spdx_test.rs"],
    data = ["//:all_files"],
    tags = CHECK,
)

# Build output stays ignored.
rust_test(
    name = "gitignore",
    srcs = ["gitignore_test.rs"],
    data = ["//:.gitignore"],
    tags = CHECK,
)

# Versions pinned twice agree.
rust_test(
    name = "pins",
    srcs = ["pins_test.rs"],
    data = [
        "//:Cargo.lock",
        "//:MODULE.bazel",
    ],
    tags = CHECK,
)

# Dependencies are permissively licensed (cargo-deny, installed on the
# machine; it reads the crates' metadata from crates.io).
rust_test(
    name = "licenses",
    srcs = ["licenses_test.rs"],
    data = [
        "//:Cargo.lock",
        "//:Cargo.toml",
        "//:all_files",
        "@local_tools//:cargo-deny",
        "@local_tools//:cargo_deny_version.txt",
        "@rules_rust//tools/upstream_wrapper:cargo",
    ],
    env = {
        "CARGO": "$(rootpath @rules_rust//tools/upstream_wrapper:cargo)",
        "CARGO_DENY": "$(rootpath @local_tools//:cargo-deny)",
        "WORKSPACE_MANIFEST": "$(rootpath //:Cargo.toml)",
    },
    tags = CHECK + [
        "no-sandbox",
        "requires-network",
    ],
)

# The static checks are only static checks: every test of //:checks is
# tagged `check` (the query lists those that aren't).
genquery(
    name = "unchecked_tests",
    expression = "tests(//:static_checks) except attr(tags, '[^a-z_-]check[^a-z_-]', tests(//:static_checks))",
    scope = ["//:static_checks"],
)

rust_test(
    name = "checks_static",
    srcs = ["checks_static_test.rs"],
    data = [":unchecked_tests"],
    env = {"UNCHECKED_TESTS": "$(rootpath :unchecked_tests)"},
    tags = CHECK,
)

# `bazel test //...` runs only hermetic, deterministic tests: no static
# check, game-data test or browser suite. The query lists those it would
# run, from every package's `default_tests` (genquery takes no wildcards).
genquery(
    name = "default_unwanted",
    expression = "attr(tags, '[^a-z_-](check|gamedata|browser)[^a-z_-]', tests(//:default_tests))",
    scope = ["//:default_tests"],
)

rust_test(
    name = "default_only",
    srcs = ["default_only_test.rs"],
    data = [":default_unwanted"],
    env = {"DEFAULT_UNWANTED": "$(rootpath :default_unwanted)"},
    tags = CHECK,
)

volya_checks(wasm = False)
