# The Open Dynamics Engine's 0.5.0 release: the core's sources and headers,
# for volya-engine-core's build script; not the triangle mesh's sources
# (among them the Magic Software file) or OPCODE, DrawStuff, tests or
# contributions (the core includes the mesh's ODE headers only). Its BSD
# notice.
filegroup(
    name = "sources",
    srcs = glob(
        [
            "include/ode/*.h",
            "ode/src/*.cpp",
            "ode/src/*.h",
        ],
        exclude = [
            "ode/src/collision_trimesh*.cpp",
            "ode/src/scrapbook.cpp",
        ],
    ),
    visibility = ["//visibility:public"],
)

exports_files(
    ["LICENSE-BSD.TXT"],
    visibility = ["//visibility:public"],
)
