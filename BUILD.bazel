exports_files([
    ".gitignore",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "MODULE.bazel",
    "deny.toml",
    # The trigger table and the areas (//tools/xtask:areas).
    "docs/architecture/build.md",
    "tests/areas.txt",
])

# Every package. A new package adds its `volya_checks()` and a line here.
PACKAGES = [
    "//build",
    "//build/platforms",
    "//crates/volya-engine",
    "//crates/volya-engine-core",
    "//crates/volya-engine-formats",
    "//crates/volya-engine-installer",
    "//crates/volya-engine-render",
    "//crates/volya-engine-script",
    "//platforms/web",
    "//tests/browser",
    "//tests/d3d9probes",
    "//tests/fidelity",
    "//tests/odeharness",
    "//third_party/inno",
    "//third_party/ode",
    "//third_party/rust",
    "//tools/devserver",
    "//tools/gog-extract",
    "//tools/site",
    "//tools/wincapture",
    "//tools/xtask",
]

# The source tree, for the checks that read it (//build:spdx, :licenses).
filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = [
            ".git/**",
            # Bazel's convenience links to its outputs.
            "bazel-*/**",
            # The machine's own settings (.bazelrc), never committed.
            "user.bazelrc",
        ],
    ) + [p + ":all_files" for p in PACKAGES],
    visibility = ["//build:__pkg__"],
)

# Every suite here is manual: `bazel test //...` would run every test a
# suite it matches names, and it runs only hermetic, deterministic tests
# (//build:default_only).

# What `bazel test //...` runs: every package's (//build:default_only).
test_suite(
    name = "default_tests",
    tags = ["manual"],
    tests = [p + ":default_tests" for p in PACKAGES],
    visibility = ["//build:__pkg__"],
)

# Every test and test suite but the static checks (which check this list,
# //tools/xtask:areas): every package's and the root's.
test_suite(
    name = "all_tests",
    tags = ["manual"],
    tests = [":gamedata"] + [p + ":all_tests" for p in PACKAGES],
    visibility = ["//tools/xtask:__pkg__"],
)

# The tests that read the game data, but those that walk the whole game or
# measure (docs/architecture/build.md, Native tests): `bazel test
# //:gamedata`, or a package's `:gamedata`.
test_suite(
    name = "gamedata",
    tags = ["manual"],
    tests = [
        "//crates/volya-engine:gamedata",
        "//crates/volya-engine-core:gamedata",
        "//crates/volya-engine-formats:gamedata",
        "//crates/volya-engine-installer:gamedata",
        "//crates/volya-engine-script:gamedata",
    ],
)

# The static checks: `bazel test //:checks`. Each is tagged `check` and
# `manual` (//build:checks_static, :default_only): nothing that builds the
# engine or runs a browser.
test_suite(
    name = "checks",
    tags = ["manual"],
    tests = [
        ":static_checks",
        "//build:checks_static",
        "//build:default_only",
    ],
)

test_suite(
    name = "static_checks",
    tags = ["manual"],
    tests = [
        "//build:gitignore",
        "//build:licenses",
        "//build:pins",
        "//build:spdx",
        "//tools/xtask:areas",
        "//platforms/web:notices",
    ] + [p + ":checks" for p in PACKAGES],
    visibility = ["//build:__pkg__"],
)
