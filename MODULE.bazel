"""Volya Engine's Bazel module (docs/architecture/build.md)."""

module(name = "volya_engine")

# First, so its C toolchain (Xcode's clang) is the one registered.
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = ["wasm32-unknown-unknown"],
    # The release profile's opt-level (Cargo.toml).
    opt_level = {
        "dbg": "0",
        "fastbuild": "0",
        "opt": "s",
    },
    # wasm32: web-sys bindings still marked unstable (e.g. read-only OPFS
    # sync handles): compile errors, not silent failures, when they change.
    extra_rustc_flags_triples = {
        "wasm32-unknown-unknown": ["--cfg=web_sys_unstable_apis"],
    },
    versions = ["1.100.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# External crates from the workspace's Cargo.toml files and Cargo.lock.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/volya-engine:Cargo.toml",
        "//crates/volya-engine-core:Cargo.toml",
        "//crates/volya-engine-formats:Cargo.toml",
        "//crates/volya-engine-installer:Cargo.toml",
        "//crates/volya-engine-render:Cargo.toml",
        "//crates/volya-engine-script:Cargo.toml",
        "//platforms/web:Cargo.toml",
        "//tools/devserver:Cargo.toml",
        "//tools/gog-extract:Cargo.toml",
        "//tools/site:Cargo.toml",
        "//tools/xtask:Cargo.toml",
    ],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "wasm32-unknown-unknown",
    ],
)

# The dev profile's optimisation of decoding and hashing (Cargo.toml), in
# native builds only: in the app they follow its profile, as the release
# profile has them (measured: 75 KB more wasm at 3 than at s).
crate.annotation_select(
    crate = "lewton",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    triples = ["aarch64-apple-darwin"],
)
crate.annotation_select(
    crate = "md-5",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    triples = ["aarch64-apple-darwin"],
)
crate.annotation_select(
    crate = "ogg",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    triples = ["aarch64-apple-darwin"],
)
crate.annotation_select(
    crate = "ogg_nrp",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    triples = ["aarch64-apple-darwin"],
)
crate.annotation_select(
    crate = "theora_nrp",
    repositories = ["crates"],
    rustc_flags = ["-Copt-level=3"],
    triples = ["aarch64-apple-darwin"],
)

# File install conditions exposed (docs/architecture/game-data.md):
# our patch to the crates.io release (also @gog_extractor's). The release
# ships no licence text: its repository's, for the site's notices
# (build/notices.bzl).
crate.annotation(
    compile_data = ["@@//third_party/inno:LICENSE-MIT.md"],
    crate = "inno",
    patch_args = ["-p1"],
    patches = ["//third_party/inno:expose-file-conditions.patch"],
    repositories = ["crates"],
)

use_repo(crate, "crates")

# Tools built from crates.io: the wasm-bindgen CLI, which must equal the
# wasm-bindgen crate in Cargo.lock (`update` keeps them equal).
crate.spec(
    package = "wasm-bindgen-cli",
    repositories = ["tools"],
    version = "=0.2.130",
)
crate.annotation(
    crate = "wasm-bindgen-cli",
    gen_binaries = ["wasm-bindgen"],
    repositories = ["tools"],
)
crate.from_specs(
    name = "tools",
    supported_platform_triples = ["aarch64-apple-darwin"],
)
use_repo(crate, "tools")

# The LLVM that builds the script runtime's C for wasm32 (wasi-sdk's clang;
# docs/architecture/build.md, Build scripts).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "wasm_llvm",
    build_file = "//build:wasm_llvm.BUILD.bazel",
    sha256 = "9c59398106b417f8f14913380fdf0097a8cc0ff4af9eb3ce0065a859e88d49e9",
    strip_prefix = "wasi-sdk-34.0-arm64-macos",
    url = "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-34/wasi-sdk-34.0-arm64-macos.tar.gz",
)

# The physics solver (docs/architecture/simulation.md): the Open Dynamics
# Engine's 0.5.0 release, the shipped library's base, changed as the shipped
# library and computing in its SSE arithmetic (our patches), its core built
# by volya-engine-core's build script under its BSD option. Not updated: the
# release is fixed by the shipped library (docs/behavior/physics-library.md).
http_archive(
    name = "ode",
    build_file = "//build:ode.BUILD.bazel",
    patch_args = ["-p1"],
    patches = [
        "//third_party/ode:shipped-library.patch",
        "//third_party/ode:sse-arithmetic.patch",
    ],
    sha256 = "5388c4cd4666f270f18216c90ab6526229c53fdc7e82f93ddb0824e69521df1c",
    strip_prefix = "ode-0.5",
    url = "https://downloads.sourceforge.net/project/opende/ODE/ODE%20version%200.5/ode-0.5.tgz",
)

# 0.5.0's generated matrix routines (fastdot, fastldlt, fastlsolve,
# fastltsolve) carry no licence header; ODE 0.14's (the same as 0.13's, the
# first with the header) are the same code under ODE's dual licence header,
# only their includes and an added wrapper differing, so they are taken from
# there.
http_archive(
    name = "ode_fast",
    build_file_content = """load("@@//build:notices.bzl", "third_party")

third_party(
    name = "fast",
    component = "The generated matrix routines (fastdot, fastldlt, fastlsolve, fastltsolve) of the Open Dynamics Engine 0.14 release",
    license = "LGPL-2.1-or-later OR BSD-3-Clause",
    notices = ["LICENSE-BSD.TXT"],
    srcs = glob(["ode/src/fast*.c"]),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(["ode/src/fast*.c"]) + ["LICENSE-BSD.TXT"],
    visibility = ["//visibility:public"],
)""",
    sha256 = "a6e22c3713e656d4c8114415089f4aaa685e24fab3a8ad7f3ee54692e5e8d318",
    strip_prefix = "ode-0.14",
    url = "https://bitbucket.org/odedevs/ode/downloads/ode-0.14.tar.gz",
)

# The Windows cross LLVM that builds the Direct3D 9 probes' executable
# (build/d3d9probes.bzl): llvm-mingw's macOS release, clang, lld and the
# MinGW targets' headers and libraries.
http_archive(
    name = "llvm_mingw",
    build_file_content = """filegroup(
    name = "files",
    srcs = glob(["**"], exclude = ["bin/lldb*", "lib/liblldb*", "share/**"]),
    visibility = ["//visibility:public"],
)

exports_files(["bin/i686-w64-mingw32-clang"], visibility = ["//visibility:public"])
""",
    sha256 = "98d340bbb8d46b09ad6886ffba88bd9d5415e131c316de48e6bd7647377446aa",
    strip_prefix = "llvm-mingw-20261117-ucrt-macos-universal",
    url = "https://github.com/mstorsjo/llvm-mingw/releases/download/20261117/llvm-mingw-20261117-ucrt-macos-universal.tar.xz",
)

# DynamoRIO (BSD; License.txt), for the original's capture on Windows
# (tools/wincapture/counter.c): its Windows release, of which the 32-bit
# drrun and runtime go into the capture runner and its headers and import
# library build the client. None of its LGPL extensions is used or shipped.
http_archive(
    name = "dynamorio",
    build_file_content = """filegroup(
    name = "client_sdk",
    srcs = glob(["include/**/*.h"]) + ["lib32/release/dynamorio.lib"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "runtime",
    srcs = [
        "License.txt",
        "bin32/drconfig.exe",
        "bin32/drconfiglib.dll",
        "bin32/drinjectlib.dll",
        "bin32/drrun.exe",
        "lib32/drearlyhelp1.dll",
        "lib32/drearlyhelp2.dll",
        "lib32/drpreinject.dll",
        "lib32/release/dynamorio.dll",
    ],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "2f434ba0f0e339f069ccc1f576a3246ef3d95d28934dae3632b544f85ee2db26",
    strip_prefix = "DynamoRIO-Windows-11.92.20777",
    url = "https://github.com/DynamoRIO/dynamorio/releases/download/cronbuild-11.92.20777/DynamoRIO-Windows-11.92.20777.zip",
)

# Tools installed on the machine, with their versions (build/local_tools.bzl).
local_tools = use_repo_rule("//build:local_tools.bzl", "local_tools")

local_tools(name = "local_tools")

# The game data (build/gog.bzl).
gog_installer = use_repo_rule("//build:gog.bzl", "gog_installer")

gog_installer(name = "gog_installer")

# The original's reference frames and captured audio, from the local cache
# (build/original_frames.bzl).
original_files = use_repo_rule("//build:original_frames.bzl", "original_files")

original_files(
    name = "original_frames",
    folder = "original-frames",
    suite = "fidelity",
)

original_files(
    name = "original_audio",
    folder = "original-audio",
    suite = "audio-fidelity",
)

gog = use_extension("//build:gog.bzl", "gog")
use_repo(gog, "gog_extractor", "gog_game", "gog_original")

# Its extractor is built with the toolchain's cargo.
rust_host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
use_repo(rust_host_tools, "rust_host_tools")
