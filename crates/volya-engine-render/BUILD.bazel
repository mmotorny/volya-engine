load("//build:checks.bzl", "volya_checks")
load("//build:rust.bzl", "volya_library")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# Translates the programs' WGSL to GLSL ES 3.00 (docs/architecture/build.md,
# Build scripts).
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    data = glob(["src/*.wgsl"]),
    deps = all_crate_deps(build = True),
)

volya_library(
    name = "volya-engine-render",
    # The render self-test, in the test app (//build:test_ops).
    crate_features = select({
        "//build:with_test_ops": ["selftest"],
        "//conditions:default": [],
    }),
    deps = [
        ":build_script",
        "//crates/volya-engine-formats",
    ],
)

volya_checks()
