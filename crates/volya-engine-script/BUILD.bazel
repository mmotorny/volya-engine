load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("//build:rust.bzl", "volya_integration_tests", "volya_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# Builds the vendored LuaJIT and our C (docs/architecture/build.md, Build
# scripts).
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    data = glob([
        "csrc/**",
        "vendor/**",
    ]),
    links = "volya_luajit",
    deps = all_crate_deps(build = True),
)

volya_library(
    name = "volya-engine-script",
    compile_data = glob(["src/**/*.lua"]),
    dev_deps = ["//crates/volya-engine-installer"],
    deps = [
        ":build_script",
        "//crates/volya-engine-core",
        "//crates/volya-engine-formats",
    ],
)

volya_integration_tests(
    crate = ":volya-engine-script",
    compile_data = ["//crates/volya-engine-formats:tests/support/gog_archives.rs"],
    deps = [
        "//crates/volya-engine-core",
        "//crates/volya-engine-formats",
        "//crates/volya-engine-installer",
    ],
)
